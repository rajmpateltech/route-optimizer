# ---- Postgres ----
POSTGRES_USER=routeoptimizer
POSTGRES_PASSWORD=routeoptimizer
POSTGRES_DB=routeoptimizer
POSTGRES_PORT=5432
DATABASE_URL=postgres://routeoptimizer:routeoptimizer@postgres:5432/routeoptimizer

# ---- Redis (optional; used for rate limiting across instances) ----
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ---- Backend ----
PORT=8080
NODE_ENV=production
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Path to built frontend assets (empty = not served by backend)
STATIC_DIR=

# ---- Routing / OSRM ----
# hosted  -> use the public OSRM demo server (quickstart only, rate limited)
# selfhosted -> use your own OSRM instance (recommended for production / big jobs)
OSRM_MODE=hosted
OSRM_URL=https://router.project-osrm.org
# Chunk size for distance-matrix table requests (keep small for the public demo)
OSRM_TABLE_CHUNK=100
OSRM_ROUTE_WAYPOINTS=90
OSRM_THROTTLE_MS=700

# ---- Geocoding (free, pluggable) ----
# nominatim | photon | manual
GEOCODER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org
PHOTON_URL=https://photon.komoot.io
GEOCODE_DELAY_MS=1100
GEOCODE_TIMEOUT_MS=12000
GEOCODE_RETRIES=2

# ---- Optimizer service (Python / OR-Tools) ----
OPTIMIZER_URL=http://optimizer:8090

# ---- Limits ----
MAX_STOPS_PER_JOB=5000
MAX_JOBS_PER_USER=100
MAX_FILE_BYTES=10485760

# ---- Web (nginx) ----
WEB_PORT=80
